{
    "name": "yiisoft/yii2-app-advanced",
    "description": "Yii 2 Advanced Project Template (updated for PHP 8.4)",
    "keywords": ["yii2", "framework", "advanced", "project template"],
    "homepage": "https://www.yiiframework.com/",
    "type": "project",
    "license": "BSD-3-Clause",

    "support": {
        "issues": "https://github.com/yiisoft/yii2/issues",
        "forum": "https://forum.yiiframework.com/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "source": "https://github.com/yiisoft/yii2"
    },

    "minimum-stability": "stable",
    "prefer-stable": true,

    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "composer",
            "url": "https://packagist.org"
        }
    ],

    "require": {
        "php": ">=8.0",
        "yiisoft/yii2": "^2.0.53",
        "yiisoft/yii2-bootstrap": "*",
        "yiisoft/yii2-swiftmailer": "*",
        "mihaildev/yii2-ckeditor": "*",
        "mihaildev/yii2-elfinder": "*",
        "dmstr/yii2-adminlte-asset": "2.*",
        "metalguardian/yii2-i18n-module": "dev-master",
        "omnilight/yii2-shopping-cart": "*",
        "alex290/yii2-treeselect": "*",
        "kartik-v/yii2-nav-x": "dev-master",
        "kartik-v/yii2-widget-growl": "*",
        "kartik-v/yii2-widget-alert": "*",
        "la-haute-societe/yii2-save-relations-behavior": "*",
        "samdark/sitemap": "^2.2",
        "wbraganca/yii2-dynamicform": "*",
        "symfony/dom-crawler": "^5.4",
        "symfony/css-selector": "^5.4",
        "yii-dream-team/yii2-upload-behavior": "*",
        "loveorigami/yii2-modal-ajax": "dev-master",
        "codemix/yii2-localeurls": "^1.7",
        "omgdef/yii2-multilingual-behavior": "^2.1",
        "wayforpay/php-sdk": "^1.0",
        "bower-asset/jquery": "^3.6",
        "bower-asset/inputmask": "^5.0"
    },

    "require-dev": {
        "yiisoft/yii2-codeception": "*",
        "yiisoft/yii2-debug": "*",
        "yiisoft/yii2-gii": "*",
        "yiisoft/yii2-faker": "*"
    },

    "config": {
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "composer/installers": true
        }
    },

    "extra": {
        "asset-installer-paths": {
            "npm-asset-library": "vendor/npm",
            "bower-asset-library": "vendor/bower"
        }
    },

    "scripts": {
        "post-install-cmd": "php init --env=Development --overwrite=n"
    }
}
